{
  "name": "race-analysis-hub-backend",
  "version": "1.16.0",
  "description": "API REST pubblica per Race Analysis Hub",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node --max-old-space-size=192 server.js",
    "dev": "nodemon --watch . --ext js,json --ignore .translation-cache/ --exec node scripts/avviaSviluppo.js",
    "seed": "node scripts/importaDati.js",
    "gp": "node scripts/registraGpConcluso.js",
    "aggiorna-gp": "node scripts/registraGpConcluso.js",
    "set-current": "node scripts/impostaGaraAttuale.js",
    "test": "node --test test/*.test.js",
    "lint:api": "node scripts/verificaOpenApi.js",
    "sync-f1db": "node scripts/sincronizzaF1db.js",
    "verify-data": "node scripts/verificaQualitaDati.js",
    "verify-docs": "node scripts/verificaDocumentazione.js",
    "verify-translations": "node scripts/verificaTraduzioni.js",
    "translate-data": "python3 scripts/generaTraduzioni.py",
    "verify-db": "node scripts/verificaDatabasePostgres.js",
    "verify-mongo-legacy": "node scripts/verificaDatabase.js",
    "compare-migration-sources": "node scripts/confrontaSorgentiMigrazione.js",
    "migrate-mongo-supabase": "node scripts/migraMongoSupabase.js",
    "archive-mongo-supabase": "node scripts/archiviaRestoMongoSupabase.js",
    "verify-supabase-parity": "node scripts/verificaParitaSupabase.js",
    "verify-api-parity": "node scripts/verificaParitaApi.js",
    "verify-postgres-writes": "node scripts/verificaScritturePostgres.js",
    "import-context-postgres": "node scripts/importaStatisticheContestoPostgres.js",
    "migrate:supabase": "node scripts/sincronizzaCatalogoSupabase.js",
    "lint:api:v2": "node scripts/verificaOpenApi.js --v2",
    "verify-api:v2": "node scripts/verificaApiV2.js",
    "check:auto-gp": "node --max-old-space-size=192 scripts/controllaAggiornamentoAutomatico.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fflate": "0.8.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.2",
    "pdfjs-dist": "5.4.624",
    "pg": "8.23.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@redocly/cli": "^2.46.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14"
  }
}
