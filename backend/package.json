{
  "name": "race-analysis-hub-backend",
  "version": "1.11.0",
  "description": "API REST pubblica per Race Analysis Hub",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch . --ext js,json --ignore .translation-cache/ --exec node scripts/avviaSviluppo.js",
    "seed": "node scripts/importaDati.js",
    "gp": "node scripts/registraGpConcluso.js",
    "aggiorna-gp": "node scripts/registraGpConcluso.js",
    "set-current": "node scripts/impostaGaraAttuale.js",
    "test": "node --test test/*.test.js",
    "lint:api": "node scripts/verificaOpenApi.js",
    "sync-f1db": "node scripts/sincronizzaF1db.js",
    "verify-data": "node scripts/verificaQualitaDati.js",
    "verify-translations": "node scripts/verificaTraduzioni.js",
    "translate-data": "python3 scripts/generaTraduzioni.py",
    "verify-db": "node scripts/verificaDatabase.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.2",
    "pdfjs-dist": "5.4.624",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@redocly/cli": "^2.46.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14"
  }
}
